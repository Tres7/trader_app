POSTGRES_DB=traderapp
POSTGRES_USER=traderapp
POSTGRES_PASSWORD=change_me
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/traderapp
SPRING_DATASOURCE_USERNAME=traderapp
SPRING_DATASOURCE_PASSWORD=change_me
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=docker

JWT_SECRET=change_me
JWT_EXPIRATION_MINUTES=60

MAIL_USERNAME=
MAIL_PASSWORD=

# SPRING_RABBITMQ_* est lu par l'appli Spring Boot pour SE CONNECTER au broker.
# RABBITMQ_USER / RABBITMQ_PASS est lu par l'image rabbitmq elle-même pour définir
# ses propres identifiants par défaut (voir compose.yaml, service rabbitmq).
# Ces deux paires doivent contenir les MÊMES valeurs, sinon l'appli ne peut pas
# s'authentifier auprès de son propre broker.
# Pour RABBITMQ_PASS : utiliser `openssl rand -hex N` (alphanumérique), pas
# `openssl rand -base64` -- l'image RabbitMQ officielle échoue silencieusement
# à créer l'utilisateur par défaut si le mot de passe contient `/`, `+` ou `=`.
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=traderapp
SPRING_RABBITMQ_PASSWORD=traderapp_rabbit_password
RABBITMQ_USER=traderapp
RABBITMQ_PASS=traderapp_rabbit_password