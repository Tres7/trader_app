# Template pour /opt/traderapp/shared/server.env sur le VPS.
# Aucune valeur réelle ici -- copier ce fichier sur le VPS, remplir avec les vraies
# valeurs, puis `chmod 600`. Ce fichier n'est jamais committé ni régénéré par la CI.

POSTGRES_DB=traderapp
POSTGRES_USER=traderapp
POSTGRES_PASSWORD=change_me

SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/traderapp
SPRING_DATASOURCE_USERNAME=traderapp
SPRING_DATASOURCE_PASSWORD=change_me
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

JWT_SECRET=change_me
JWT_EXPIRATION_MINUTES=60

MAIL_USERNAME=
MAIL_PASSWORD=

# SPRING_RABBITMQ_* est lu par l'appli Spring Boot pour SE CONNECTER au broker.
# RABBITMQ_USER / RABBITMQ_PASS est lu par l'image rabbitmq elle-même pour définir
# ses propres identifiants par défaut (voir docker-compose.prod.yaml, service rabbitmq).
# Ces deux paires doivent contenir les MÊMES valeurs.
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=traderapp
SPRING_RABBITMQ_PASSWORD=change_me
RABBITMQ_USER=traderapp
RABBITMQ_PASS=change_me

# Backup (voir .github/scripts/backup-db.sh)
R2_BUCKET=
RCLONE_CONFIG_R2_ENDPOINT=
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
BACKUP_RETENTION=10
